# ---- Database (required) ----
# Postgres connection string. On Vercel, add a Postgres store from the
# Marketplace tab and this is injected automatically.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth (required) ----
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# ---- Email reminders (optional) ----
# Without these the app still runs; reminders are logged to the server console
# instead of being emailed. Get a key at https://resend.com
RESEND_API_KEY=""
REMINDER_FROM_EMAIL="DSMS <onboarding@resend.dev>"

# ---- Cron protection (optional but recommended in production) ----
# Vercel sends this as a Bearer token to /api/cron/reminders.
CRON_SECRET=""
