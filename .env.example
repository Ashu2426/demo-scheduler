# You do NOT need this file to deploy on Vercel.
# If you attach a Postgres database from the Vercel Marketplace, DATABASE_URL is
# injected automatically and everything else below is optional.
#
# Copy to `.env` only if you want to run the app on your own machine.

# ---- Database (required) ----
# Paste the connection string from your Vercel/Neon database.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth (optional) ----
# If unset, a stable signing key is derived from DATABASE_URL automatically.
# Set it explicitly if you want to rotate sessions independently of the database.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ---- Email reminders (optional) ----
# Without a key, reminders are written to the server log instead of emailed.
# Free key at https://resend.com
RESEND_API_KEY=""
REMINDER_FROM_EMAIL="DSMS <onboarding@resend.dev>"

# ---- Cron protection (optional) ----
# Vercel sends this as a Bearer token to /api/cron/reminders.
CRON_SECRET=""

# ---- Links inside reminder emails (optional) ----
# Defaults to the Vercel deployment URL.
NEXT_PUBLIC_APP_URL=""
